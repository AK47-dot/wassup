# Copy this file to .env and fill in your real values. Never commit .env itself.

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/wassup_journal?retryWrites=true&w=majority

# Google OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Groq API Configuration (strictly server-side)
GROQ_API_KEY=your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=openai/gpt-oss-120b

# Server Port
PORT=3000
NODE_ENV=development
